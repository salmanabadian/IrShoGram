rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'displayName', 'bio', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && validText(request.resource.data.username, 30)
        && validText(request.resource.data.displayName, 80)
        && validText(request.resource.data.bio, 300);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'displayName', 'bio', 'photoUrl', 'updatedAt'
        ])
        && validText(request.resource.data.username, 30)
        && validText(request.resource.data.displayName, 80)
        && validText(request.resource.data.bio, 300);
      allow delete: if isOwner(uid);

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if isOwner(uid)
          && targetUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && exists(/databases/$(database)/documents/users/$(targetUid));
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        // Follower documents are maintained by trusted backend code.
        allow write: if false;
      }

      match /savedPosts/{postId} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read, update: if isOwner(uid)
          && (request.method != 'update'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
        allow create, delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId', 'caption', 'mediaUrl', 'mediaType', 'createdAt', 'updatedAt'
        ])
        && validText(request.resource.data.caption, 2200)
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.mediaUrl is string;
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'caption', 'updatedAt'
        ])
        && validText(request.resource.data.caption, 2200);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && validText(request.resource.data.text, 2000)
          && request.resource.data.text.size() > 0;
        allow update: if signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && validText(request.resource.data.text, 2000)
          && request.resource.data.text.size() > 0;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId', 'mediaUrl', 'mediaType', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.mediaUrl is string
        && request.resource.data.expiresAt is timestamp;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId', 'caption', 'mediaUrl', 'createdAt'
        ])
        && validText(request.resource.data.caption, 2200)
        && request.resource.data.mediaUrl is string;
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption']);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() >= 2
        && request.resource.data.participantIds.size() <= 2
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt', 'updatedAt']);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        function isConversationMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }

        allow read: if isConversationMember();
        allow create: if isConversationMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'mediaUrl', 'createdAt', 'type'])
          && validText(request.resource.data.text, 5000);
        allow update, delete: if false;
      }
    }
  }
}
