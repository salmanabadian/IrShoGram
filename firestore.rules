rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 30
        && value.matches('[a-zA-Z0-9._]{3,30}');
    }

    function validDisplayName(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 80;
    }

    function validProfilePhoto(value) {
      return value == null
        || value == ''
        || (
          value is string
          && value.size() <= 2048
          && value.matches('https://.*')
        );
    }

    function validMediaUrl(value) {
      return value is string
        && value.size() > 8
        && value.size() <= 2048
        && value.matches('https://[^/]+.*');
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'displayName', 'bio', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'displayName', 'bio', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && validUsername(request.resource.data.username)
        && validDisplayName(request.resource.data.displayName)
        && validText(request.resource.data.bio, 300)
        && validProfilePhoto(request.resource.data.photoUrl)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'displayName', 'bio', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'username', 'displayName', 'bio', 'photoUrl', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'displayName', 'bio', 'photoUrl', 'updatedAt'
        ])
        && validUsername(request.resource.data.username)
        && validDisplayName(request.resource.data.displayName)
        && validText(request.resource.data.bio, 300)
        && validProfilePhoto(request.resource.data.photoUrl)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);

      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if isOwner(uid)
          && targetUid != uid
          && request.resource.data.keys().hasOnly(['createdAt', 'targetUid'])
          && request.resource.data.targetUid == targetUid
          && exists(/databases/$(database)/documents/users/$(targetUid));
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /followers/{followerUid} {
        allow read: if signedIn();
        // Follower documents are maintained by trusted backend code.
        allow write: if false;
      }

      match /savedPosts/{postId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt is timestamp
          && request.resource.data.savedAt <= request.time
          && exists(/databases/$(database)/documents/posts/$(postId));
        // Saved-post markers are immutable; the owner removes them to unsave.
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        // Notifications are created and removed only by trusted backend code.
        allow create, delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId', 'caption', 'mediaUrl', 'mediaType', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'authorId', 'caption', 'mediaUrl', 'mediaType', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && validText(request.resource.data.caption, 2200)
        && request.resource.data.mediaType in ['image', 'video']
        && validMediaUrl(request.resource.data.mediaUrl)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId', 'caption', 'mediaUrl', 'mediaType', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'authorId', 'caption', 'mediaUrl', 'mediaType', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'caption', 'updatedAt'
        ])
        && validText(request.resource.data.caption, 2200)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && validText(request.resource.data.text, 2000)
          && request.resource.data.text.size() > 0;
        allow update: if signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && validText(request.resource.data.text, 2000)
          && request.resource.data.text.size() > 0;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId', 'mediaUrl', 'mediaType', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.keys().hasAll([
          'authorId', 'mediaUrl', 'mediaType', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && validMediaUrl(request.resource.data.mediaUrl)
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId', 'caption', 'mediaUrl', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'authorId', 'caption', 'mediaUrl', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && validText(request.resource.data.caption, 2200)
        && validMediaUrl(request.resource.data.mediaUrl)
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'authorId', 'caption', 'mediaUrl', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'authorId', 'caption', 'mediaUrl', 'createdAt'
        ])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
        && validText(request.resource.data.caption, 2200);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] is string
        && request.resource.data.participantIds[1] is string
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && request.auth.uid in request.resource.data.participantIds
        && conversationId == request.resource.data.participantIds[0] + '_'
          + request.resource.data.participantIds[1]
        && request.resource.data.keys().hasOnly(['participantIds', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['participantIds', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        function isConversationMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }

        allow read: if isConversationMember();
        allow create: if isConversationMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'mediaUrl', 'createdAt', 'type'])
          && request.resource.data.keys().hasAll(['senderId', 'text', 'mediaUrl', 'createdAt', 'type'])
          && validText(request.resource.data.text, 5000)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time
          && request.resource.data.type in ['text', 'image', 'video']
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text.size() > 0
              && request.resource.data.mediaUrl == null)
            ||
            (request.resource.data.type in ['image', 'video']
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0)
          );
        allow update, delete: if false;
      }
    }
  }
}
